<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.adamjohnson.pokebinder.ui.login.LoginFragment"
        android:label="LoginFragment" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.adamjohnson.pokebinder.ui.feed.FeedFragment"
        android:label="FeedFragment" />

    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.adamjohnson.pokebinder.ui.collection.CollectionFragment"
        android:label="CollectionFragment" />

    <fragment
        android:id="@+id/cardSearchFragment"
        android:name="com.adamjohnson.pokebinder.ui.cardsearch.CardSearchFragment"
        android:label="CardSearchFragment" />

    <fragment
        android:id="@+id/binderEditorFragment"
        android:name="com.adamjohnson.pokebinder.ui.binder.BinderEditorFragment"
        android:label="BinderEditorFragment">

        <argument
            android:name="pageId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/draftsFragment"
        android:name="com.adamjohnson.pokebinder.ui.drafts.DraftsFragment"
        android:label="DraftsFragment" />

    <fragment
        android:id="@+id/pageDetailFragment"
        android:name="com.adamjohnson.pokebinder.ui.detail.PageDetailFragment"
        android:label="PageDetailFragment">

        <argument
            android:name="pageId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/socialPagesFragment"
        android:name="com.adamjohnson.pokebinder.ui.feed.SocialPagesFragment"
        android:label="SocialPagesFragment">

        <argument
            android:name="listMode"
            android:defaultValue="likes"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.adamjohnson.pokebinder.ui.profile.ProfileFragment"
        android:label="ProfileFragment" />

</navigation>