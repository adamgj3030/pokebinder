<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                tools:text="Grass Favorites" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textStyle="bold"
                tools:text="Draft" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/binders_delete_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot1ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot2ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot3ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot4ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot5ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot6ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot7ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot8ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot9ImageView"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/darker_gray"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/metaTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="6 likes • 2 comments" />

</LinearLayout>