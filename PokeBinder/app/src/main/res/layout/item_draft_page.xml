<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_feed_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/poke_text"
                android:textStyle="bold"
                tools:text="Grass Favorites" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_counter_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/poke_red_dark"
                android:textStyle="bold"
                tools:text="Draft" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cta_danger"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/binders_delete_button"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_binder_board"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot1ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot2ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot3ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot4ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot5ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot6ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot7ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot8ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <ImageView
                android:id="@+id/slot9ImageView"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/metaTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_counter_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text_secondary"
        tools:text="6 likes • 2 comments" />

</LinearLayout>