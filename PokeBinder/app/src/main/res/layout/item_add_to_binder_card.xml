<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feed_item"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="174dp"
            android:background="@drawable/bg_binder_slot"
            android:padding="5dp">

            <ImageView
                android:id="@+id/cardImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pokemon_card_image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_report_image" />

            <View
                android:id="@+id/selectionOverlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55F4C542"
                android:visibility="gone" />

            <TextView
                android:id="@+id/removeSelectionTextView"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_cta_danger"
                android:gravity="center"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/cardNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/poke_text"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>