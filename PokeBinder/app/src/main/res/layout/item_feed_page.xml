<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_feed_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/poke_text"
            android:textStyle="bold"
            tools:text="Grass Favorites" />

        <TextView
            android:id="@+id/creatorUsernameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:maxWidth="128dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/poke_text_secondary"
            tools:text="by AdamJohnson" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_binder_board"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot1ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot2ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot3ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot4ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot5ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot6ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/slot7ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot8ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/slot9ImageView"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_binder_slot"
                android:contentDescription="@string/pokemon_card_image"
                android:padding="3dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/socialInfoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_counter_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text_secondary"
        tools:text="6 likes • 2 comments" />

</LinearLayout>