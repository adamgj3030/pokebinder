<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/pageTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold"
                tools:text="Grass Favorites" />

            <TextView
                android:id="@+id/creatorUsernameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="By AdamJohnson" />

            <TextView
                android:id="@+id/publishedAtTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Published Apr 19, 2026, 2:15 PM" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slot1ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot2ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot3ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slot4ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot5ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot6ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slot7ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot8ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <ImageView
                        android:id="@+id/slot9ImageView"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/darker_gray"
                        android:contentDescription="@string/pokemon_card_image"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_report_image" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/socialSectionTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/page_detail_social_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/likeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/page_detail_like" />

                <TextView
                    android:id="@+id/likeCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Likes: 3" />

                <TextView
                    android:id="@+id/commentCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Comments: 2" />
            </LinearLayout>

            <TextView
                android:id="@+id/addCommentTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/page_detail_add_comment_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <EditText
                android:id="@+id/commentEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:gravity="top|start"
                android:hint="@string/page_detail_comment_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                tools:text="Love the grass theme on this page." />

            <Button
                android:id="@+id/submitCommentButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/page_detail_submit_comment" />

            <TextView
                android:id="@+id/commentSubmissionMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"
                tools:text="Comment added."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/commentsSectionTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/page_detail_comments_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:id="@+id/commentsLoadingView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/page_detail_comments_loading"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <TextView
                android:id="@+id/commentsMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"
                tools:text="No comments yet. Be the first to comment."
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:itemCount="3"
                tools:listitem="@layout/item_comment" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/pageMessageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/page_detail_empty_message"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        tools:text="Published page not found."
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/page_detail_loading"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@android:color/white" />
    </LinearLayout>

</FrameLayout>