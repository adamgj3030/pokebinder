<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/card_search_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/poke_text"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/searchToggleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_topbar_icon_button"
                android:contentDescription="@string/show_search_and_filters"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/poke_red_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchFiltersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_section_surface"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <AutoCompleteTextView
                android:id="@+id/nameSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="@string/common_name"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/setSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="@string/common_set"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/typeSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="@string/common_type"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <EditText
                android:id="@+id/cardIdSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:hint="@string/common_card_id"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/subtypeSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="@string/common_subtype"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/raritySearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="@string/common_rarity"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <CheckBox
                android:id="@+id/fullArtOnlyCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/poke_red_dark"
                android:text="@string/common_full_art_only"
                android:textColor="@color/poke_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/clearFiltersButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cta_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/common_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/poke_text" />

                <Button
                    android:id="@+id/applySearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_cta_primary"
                    android:backgroundTint="@null"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/common_search"
                    android:textAllCaps="false"
                    android:textColor="@color/poke_text_on_red" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/resultCountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_counter_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/card_search_results_default"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/poke_text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardResultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/card_search_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/poke_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyStateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/emptyTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_search_empty_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/poke_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/card_search_empty_message"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/poke_text_secondary" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>