<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_screen"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/draftsTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/binders_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/poke_text"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/searchToggleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_topbar_icon_button"
            android:contentDescription="@string/binders_show_search"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="@color/poke_red_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/totalBindersCountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_counter_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/binders_total_count_zero"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/searchFiltersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_section_surface"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_binder_slot"
            android:hint="@string/binders_search_hint"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/poke_text"
            android:textColorHint="@color/poke_text_secondary"
            tools:text="grass" />

        <RadioGroup
            android:id="@+id/filterRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/allRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/poke_red_dark"
                android:checked="true"
                android:text="@string/binders_filter_all"
                android:textColor="@color/poke_text" />

            <RadioButton
                android:id="@+id/draftsOnlyRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/poke_red_dark"
                android:text="@string/binders_filter_drafts"
                android:textColor="@color/poke_text" />

            <RadioButton
                android:id="@+id/publishedOnlyRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/poke_red_dark"
                android:text="@string/binders_filter_published"
                android:textColor="@color/poke_text" />
        </RadioGroup>

        <Button
            android:id="@+id/applySearchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cta_secondary"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/common_apply"
            android:textAllCaps="false"
            android:textColor="@color/poke_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/resultCountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_counter_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/binders_results_default"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/draftsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:itemCount="4"
            tools:listitem="@layout/item_draft_page" />

        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/loadingProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/loadingTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/binders_loading"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/poke_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/emptyTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/binders_error_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/poke_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyMessageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/poke_text_secondary"
                    tools:text="Unable to load binders." />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>