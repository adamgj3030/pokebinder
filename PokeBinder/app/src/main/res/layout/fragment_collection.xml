<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/collection_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/poke_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/deleteModeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cta_secondary"
                android:backgroundTint="@null"
                android:minHeight="44dp"
                android:paddingHorizontal="12dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="@color/poke_text" />

            <ImageButton
                android:id="@+id/searchToggleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_topbar_icon_button"
                android:contentDescription="Show search and filters"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/poke_red_dark" />
        </LinearLayout>

        <Button
            android:id="@+id/addCardsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cta_primary"
            android:backgroundTint="@null"
            android:minHeight="48dp"
            android:text="Add Cards"
            android:textAllCaps="false"
            android:textColor="@color/poke_text_on_red" />

        <LinearLayout
            android:id="@+id/searchFiltersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_section_surface"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <AutoCompleteTextView
                android:id="@+id/nameSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="Name"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/setSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="Set"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/typeSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="Type"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <EditText
                android:id="@+id/cardIdSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:hint="Card ID"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/subtypeSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="Subtype"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <AutoCompleteTextView
                android:id="@+id/raritySearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_binder_slot"
                android:completionThreshold="1"
                android:hint="Rarity"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/poke_text"
                android:textColorHint="@color/poke_text_secondary" />

            <CheckBox
                android:id="@+id/fullArtOnlyCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/poke_red_dark"
                android:text="Full Art only"
                android:textColor="@color/poke_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/clearFiltersButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cta_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/poke_text" />

                <Button
                    android:id="@+id/applySearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_cta_primary"
                    android:backgroundTint="@null"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="@color/poke_text_on_red" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/resultCountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_counter_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/collection_results_default"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/poke_text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/collection_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/poke_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyStateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/emptyTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/poke_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/poke_text_secondary" />

            <Button
                android:id="@+id/emptyAddCardsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_cta_primary"
                android:backgroundTint="@null"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="Add Cards"
                android:textAllCaps="false"
                android:textColor="@color/poke_text_on_red" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>