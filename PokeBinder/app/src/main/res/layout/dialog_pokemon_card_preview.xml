<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_feed_item"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/previewTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/poke_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/previewSubtitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_binder_board"
        android:padding="10dp">

        <ImageView
            android:id="@+id/previewImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_binder_slot"
            android:contentDescription="@string/pokemon_card_image"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/previewMessageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/poke_text_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/detailsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cta_primary"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/card_preview_details"
            android:textAllCaps="false"
            android:textColor="@color/poke_text_on_red" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_cta_secondary"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:text="@string/card_preview_close"
            android:textAllCaps="false"
            android:textColor="@color/poke_text" />
    </LinearLayout>

</LinearLayout>